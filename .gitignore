# ===========================================================================
#  Marina Trading IMS
#
#  Two rules matter here:
#    1. No business data. The legacy .DBF files and the SQLite database hold
#       real customer records, and the legacy password file stores plaintext
#       passwords.
#    2. Nothing over 100 MB. GitHub rejects it, and several of these files are
#       far larger than that (legacy STKREC.DBF is 658 MB, the migrated
#       database is about 1.2 GB).
# ===========================================================================

# --- the database ----------------------------------------------------------
# The whole folder is ignored, but .gitkeep is kept so the empty directory
# still exists after a clone.
database/*
!database/.gitkeep

# --- backups ---------------------------------------------------------------
# Zipped copies of the whole database: the same customer records, and about a
# third of 1.2 GB each. The folder sits at the top of the project so it is easy
# to find, which makes ignoring it more important rather than less.
backups/*
!backups/.gitkeep

# --- legacy production data ------------------------------------------------
# Only the FoxPro *source* is committed; its data files never are.
legacy/*.DBF
legacy/*.dbf
legacy/*.IDX
legacy/*.idx
legacy/*.CDX
legacy/*.cdx
legacy/*.FPT
legacy/*.fpt
legacy/*.MEM
legacy/*.mem

# Compiled FoxPro objects and DOS print spool output
legacy/*.FXP
legacy/*.fxp
legacy/*.APP
legacy/*.app
legacy/*.ERR
legacy/*.err
legacy/TEMP
legacy/TEMP.*

# Generated by legacy/run/Run-IMS.bat
legacy/run/ims.conf

# Exports produced by legacy/tools/ims.py - same data, different format
export/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.csv

# --- Python ----------------------------------------------------------------
backend/.venv/
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# --- Node --------------------------------------------------------------------
# Dev-only: eslint and nothing else. The application itself ships no JavaScript
# dependencies and has no build step.
node_modules/
package-lock.json
npm-debug.log*
.eslintcache

# --- editors and OS --------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ===========================================================================
#  MAIN.FOX is deliberately NOT ignored: it is the compiled entry point of the
#  legacy system and the only surviving copy, since MAIN.PRG was lost.
#
#  To ship a runnable demo, add a synthetic dataset and force it past the
#  rules above:   git add -f legacy/sample/*.DBF
# ===========================================================================
