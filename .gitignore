# ---------------------------------------------------------------------------
# Production data: DO NOT COMMIT.
# Contains real customer/supplier records and plaintext passwords, and several
# files exceed GitHub's 100 MB hard limit (STKREC.DBF is 658 MB).
# ---------------------------------------------------------------------------
*.DBF
*.dbf
*.IDX
*.idx
*.CDX
*.cdx
*.FPT
*.fpt
*.MEM
*.mem

# Compiled FoxPro objects
*.FOX
*.fox
*.FXP
*.fxp
*.APP
*.app
*.ERR
*.err

# Report/print scratch output
TEMP
TEMP.*

# Exports produced by tools/ims.py - these contain the same production data
export/
*.sqlite
*.csv

# DOSBox-X config generated by run/Run-IMS.bat
run/ims.conf

# Python
__pycache__/
*.pyc

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

