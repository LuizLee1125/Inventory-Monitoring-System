SET CENT ON
SET TALK OFF

SELE 1
   USE CUSTFYL INDEX CUST_N
SELE 2
   USE SRFYL

DO WHILE .NOT. EOF()
   STORE CUST_N TO SV_CUST_N
   SELE 1
   SEEK SV_CUST_N
   IF FOUND()
      STORE CUST_M TO SV_CUST_M
   ELSE
      SELE 2
      SKIP
      LOOP
   ENDIF
   SELE 2
   REPL CUST_M WITH SV_CUST_M
   SKIP
ENDDO
