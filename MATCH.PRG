* PROGRAM....: MATCH.PRG
*            : PROGRAM TO MARK TRANSACTION FILE WITH X IF IT IS
*            : GOING TO BE ARCHIVE

SET TALK OFF
SET SCOR OFF

SELE 1
   USE STKREC INDEX TRANS_CN
SELE 2
   USE TMP-ATL

DO WHILE .NOT. EOF()
   STORE INV_N TO SV_INV_N
   SELE 1
   SEEK "S"+SV_INV_N
   IF FOUND()
      DO WHILE TRANS_N=SV_INV_N .AND. .NOT. EOF()
         REPL QTY1L WITH "Z"
         SKIP
      ENDDO
   ENDIF
   SELE 2
   SKIP
ENDDO
CLOSE DATA
RETURN

