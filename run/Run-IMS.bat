@echo off
setlocal enabledelayedexpansion
title Marina Trading IMS - launcher

REM ===========================================================================
REM  Marina Trading Inventory Monitoring System - DOSBox-X launcher
REM
REM  Mounts the FoxPro runtime as C: and this project as D:, then starts MAIN.
REM
REM  EDIT THIS if your FoxPro 2.x for DOS folder is somewhere else:
REM ===========================================================================
set "FOXPRO_DIR=C:\FoxPro"

REM --- project directory = parent of this script -----------------------------
set "PROJECT_DIR=%~dp0.."
for %%I in ("%PROJECT_DIR%") do set "PROJECT_DIR=%%~fI"

REM --- locate DOSBox-X -------------------------------------------------------
set "DOSBOXX="
for %%P in (
  "C:\DOSBox-X\dosbox-x.exe"
  "%ProgramFiles%\DOSBox-X\dosbox-x.exe"
  "%ProgramFiles(x86)%\DOSBox-X\dosbox-x.exe"
) do if exist %%P set "DOSBOXX=%%~P"

if not defined DOSBOXX (
  echo [ERROR] DOSBox-X not found.
  echo         Install it with:  winget install joncampbell123.DOSBox-X
  pause & exit /b 1
)

REM --- check the FoxPro runtime ---------------------------------------------
set "FOXEXE="
for %%E in (FOXPROX.EXE FOXPRO.EXE FOXR.EXE FOXRX.EXE FP.EXE) do (
  if exist "%FOXPRO_DIR%\%%E" if not defined FOXEXE set "FOXEXE=%%E"
)

if not defined FOXEXE (
  echo.
  echo  ================================================================
  echo   FoxPro for DOS was not found in:  %FOXPRO_DIR%
  echo  ================================================================
  echo.
  echo   This system needs the FoxPro 2.x / FoxBASE+ DOS interpreter to
  echo   run. It is Microsoft proprietary software and is NOT included
  echo   in this repository.
  echo.
  echo   Copy your licensed FoxPro DOS installation into:
  echo       %FOXPRO_DIR%
  echo   ^(it should contain FOXPROX.EXE, FOXPRO.EXE or FOXR.EXE^)
  echo   or edit FOXPRO_DIR at the top of this script.
  echo.
  pause & exit /b 1
)

REM --- generate the DOSBox-X configuration ----------------------------------
set "CONF=%~dp0ims.conf"
> "%CONF%" (
  echo # Generated by Run-IMS.bat - safe to delete, it is rebuilt on each run.
  echo.
  echo [sdl]
  echo fullscreen=false
  echo autolock=false
  echo.
  echo [dosbox]
  echo title=Marina Trading IMS
  echo machine=svga_s3
  echo memsize=16
  echo.
  echo [cpu]
  echo core=auto
  echo cputype=pentium
  echo cycles=max
  echo.
  echo [dos]
  echo ver=6.22
  echo xms=true
  echo ems=true
  echo umb=true
  echo hard drive data rate limit=0
  echo.
  echo [render]
  echo aspect=true
  echo.
  echo [sdl]
  echo output=ttf
  echo.
  echo [ttf]
  echo font=
  echo winperc=90
  echo lins=25
  echo cols=80
  echo.
  echo [autoexec]
  echo @echo off
  echo mount C "%FOXPRO_DIR%"
  echo mount D "%PROJECT_DIR%"
  echo set PATH=C:\;Z:\
  echo D:
  echo echo.
  echo echo  Marina Trading - Inventory Monitoring System
  echo echo  -------------------------------------------
  echo echo  Starting FoxPro ^(%FOXEXE%^) ...
  echo echo.
  echo C:\%FOXEXE% MAIN
  echo echo.
  echo echo  Session ended. Type EXIT to close this window.
)

echo Launching...
echo   FoxPro  : %FOXPRO_DIR%  (%FOXEXE%)
echo   Data    : %PROJECT_DIR%
start "" "%DOSBOXX%" -conf "%CONF%"
endlocal
